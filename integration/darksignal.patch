+#[cfg(test)]
+mod darkapple_health_tests {
+    use super::*;
+    #[test]
+    fn producer_silence_is_independent_of_engine_heartbeat() {
+        let stats = Stats::default();
+        let state = |now| {
+            serde_json::from_str::<serde_json::Value>(&heartbeat_body("mac", now, 0, &stats, None))
+                .unwrap()["darkapple"]["status"]
+                .as_str()
+                .unwrap()
+                .to_owned()
+        };
+        assert_eq!(state(1), "unseen");
+        stats.darkapple_health_ms.store(100, Ordering::Relaxed);
+        assert_eq!(state(200), "available");
+        stats.darkapple_degraded.store(true, Ordering::Relaxed);
+        assert_eq!(state(200), "degraded");
+        assert_eq!(state(90101), "silent");
+        assert_eq!(state(99), "silent");
+    }
