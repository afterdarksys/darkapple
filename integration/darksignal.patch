+/// Fixed producer contract: no caller-selected class or arbitrary rule fallback.
+fn darkapple_rule(rule: &str) -> Option<(Class, Severity)> {
+    Some(match rule {
+        "macos.process.temporary_executable" | "macos.process.hidden_executable" => {
+            (Class::Threat, Severity::Medium)
+        }
+        "macos.persistence.launchd_changed" => (Class::Threat, Severity::Low),
+        "macos.posture.sip_disabled" => (Class::Vuln, Severity::High),
+        "macos.posture.gatekeeper_disabled" => (Class::Vuln, Severity::Medium),
+        "macos.sensor.events_dropped" => (Class::Breach, Severity::High),
+        "macos.sensor.coverage_degraded" => (Class::Threat, Severity::Medium),
+        _ => return None,
+    })
+}
+
+fn from_darkapple(body: &Value) -> Result<Option<Draft>, Error> {
+    let observed = body
+        .get("observed_at_ms")
+        .and_then(Value::as_i64)
+        .filter(|ms| valid_time(*ms))
+        .ok_or(Error::Frame)?;
+    if body.get("schema").and_then(Value::as_str) == Some("darkapple.health.v1") {
+        return if matches!(
+            body.get("status").and_then(Value::as_str),
+            Some("available" | "degraded")
+        ) {
+            Ok(None)
+        } else {
+            Err(Error::Frame)
+        };
+    }
+    if body.get("schema").and_then(Value::as_str) != Some("darkapple.event.v1") {
+        return Err(Error::Frame);
+    }
+    let id = body
+        .get("event_id")
+        .and_then(Value::as_str)
+        .ok_or(Error::Frame)?;
+    let uuid = uuid::Uuid::parse_str(id).map_err(|_| Error::Frame)?;
+    if uuid.to_string() != id {
+        return Err(Error::Frame);
+    }
+    let rule = text(body, "rule_id").ok_or(Error::Frame)?;
+    // Unknown rules must refuse rather than ACK and silently discard.
+    let (class, severity) = darkapple_rule(rule).ok_or(Error::Frame)?;
+    let provided = Severity::parse_nocved(text(body, "severity").ok_or(Error::Frame)?)?;
+    if provided != severity || text(body, "source").is_none() || text(body, "kind").is_none() {
+        return Err(Error::Frame);
+    }
+    for key in ["exe", "path"] {
+        if let Some(value) = body.get(key) {
+            let s = value.as_str().ok_or(Error::Frame)?;
+            if s.len() > 4096 || !s.starts_with('/') || s.chars().any(char::is_control) {
+                return Err(Error::Frame);
+            }
+        }
+    }
+    if let Some(pid) = body.get("pid")
+        && pid.as_u64().is_none_or(|p| p == 0 || p > u32::MAX as u64)
+    {
+        return Err(Error::Frame);
+    }
+    let summary = body
+        .get("summary")
+        .and_then(Value::as_str)
+        .ok_or(Error::Frame)?;
+    if summary.len() > 512 {
+        return Err(Error::Frame);
+    }
+    let mut draft = Draft::new(class, severity, rule, summary, observed);
+    draft.record_key = Some(id.to_owned());
+    Ok(Some(draft))
+}
+
+#[cfg(test)]
+mod darkapple_tests {
+    use super::*;
+    use serde_json::json;
+    fn body() -> Value {
+        json!({"schema":"darkapple.event.v1","event_id":"00000000-0000-4000-8000-000000000001","observed_at_ms":123,"source":"process","kind":"process.observed","rule_id":"macos.process.hidden_executable","severity":"medium","summary":"Hidden executable","pid":42,"exe":"/opt/.cache/worker"})
+    }
+    #[test]
+    fn provenance_classification_and_dedupe() {
+        let a = classify(Tool::Darkapple, "mac1", 999, 0, &body())
+            .unwrap()
+            .unwrap();
+        let b = classify(Tool::Darkapple, "mac1", 1000, 0, &body())
+            .unwrap()
+            .unwrap();
+        assert_eq!(a.dedupe, b.dedupe);
+        assert_eq!(a.class, Class::Threat);
+        assert_eq!(a.source_ref.unwrap().kind, "darkapple.event");
+        assert!(a.join.iter().any(|j| j.typ == JoinType::Exe));
+        let mut changed = body();
+        changed["event_id"] = json!("00000000-0000-4000-8000-000000000002");
+        assert_ne!(
+            a.dedupe,
+            classify(Tool::Darkapple, "mac1", 999, 0, &changed)
+                .unwrap()
+                .unwrap()
+                .dedupe
+        );
+        assert_eq!(Tool::Darkapple.ship_path(), "/v1/darksignal/darkapple");
+        assert!(!Tool::Darkapple.allowed_in(crate::frame::Mode::Store));
+    }
+    #[test]
+    fn rejects_unknown_rule_bad_id_and_severity() {
+        for (key, value) in [
+            ("rule_id", "unrecognized"),
+            ("event_id", "bad"),
+            ("severity", "critical"),
+            ("schema", "darkapple.event.v2"),
+        ] {
+            let mut b = body();
+            b[key] = json!(value);
+            assert!(classify(Tool::Darkapple, "mac1", 999, 0, &b).is_err());
+        }
+        assert!(
+            classify(
+                Tool::Darkapple,
+                "mac1",
+                999,
+                0,
+                &json!({"schema":"darkapple.health.v1","status":"available","observed_at_ms":100})
+            )
+            .unwrap()
+            .is_none()
+        );
+    }
+}
